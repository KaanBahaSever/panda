diff --git a/TSLib/Full/License.cs b/TSLib/Full/License.cs
index 92ab27f..51f0129 100644
--- a/TSLib/Full/License.cs
+++ b/TSLib/Full/License.cs
@@ -106,6 +106,25 @@ public static R<(LicenseBlock block, int read), string> Parse(ReadOnlySpan<byte>
 				read = 6 + nullStr.read;
 				break;
 
+			case 8:
+				// TS5/TS6 server license: 1 byte license type, 1 byte property count,
+				// then each property as 1 byte length + data (layout as in tsclientlib).
+				var props = data.Slice(MinBlockLen);
+				if (props.Length < 2)
+					return "License too short";
+				int pos = 2;
+				for (int i = 0; i < props[1]; i++)
+				{
+					if (pos >= props.Length)
+						return "Missing TS5 license property";
+					pos += 1 + props[pos];
+					if (pos > props.Length)
+						return "Cut off TS5 license property";
+				}
+				block = new Ts5ServerLicenseBlock(props[0]);
+				read = pos;
+				break;
+
 			case 32:
 				block = new EphemeralLicenseBlock();
 				read = 0;
@@ -212,6 +231,17 @@ public ServerLicenseBlock(string issuer, ServerLicenseType licenseType)
 		}
 	}
 
+	public class Ts5ServerLicenseBlock : LicenseBlock
+	{
+		public override ChainBlockType Type => ChainBlockType.Ts5Server;
+		public byte LicenseType { get; }
+
+		public Ts5ServerLicenseBlock(byte licenseType)
+		{
+			LicenseType = licenseType;
+		}
+	}
+
 	public class EphemeralLicenseBlock : LicenseBlock
 	{
 		public override ChainBlockType Type => ChainBlockType.Ephemeral;
@@ -227,6 +257,7 @@ public enum ChainBlockType : byte
 		//Token = 4,
 		//LicenseSign = 5,
 		//MyTsIdSign = 6,
+		Ts5Server = 8,
 		Ephemeral = 32,
 	}
 
